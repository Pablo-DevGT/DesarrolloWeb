# Copia este archivo como .env y pon tus datos de MySQL Workbench
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_contraseña
DB_NAME=sistema_citas
PORT=3000

# Login y sesiones (Integrante 5). Pon un texto largo y aleatorio, distinto en
# cada servidor; si cambia, todas las sesiones abiertas se cierran. Generar uno:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=cambia_este_secreto

# En producción (HTTPS) pon NODE_ENV=production: la cookie de sesión viaja solo
# por HTTPS. Si el servidor de producción no tiene HTTPS, agrega COOKIE_SEGURA=0.
# NODE_ENV=production
# COOKIE_SEGURA=0
